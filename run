#!/usr/bin/env bash
set -e

ROOT="$(cd "$(dirname "$0")" && pwd)"
PORT="${1:-0}"

# If no port specified or port 0, find a random available port
if [ "$PORT" = "0" ]; then
  PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()' 2>/dev/null || echo 8080)
fi

# Kill anything on this port
if lsof -ti:"$PORT" >/dev/null 2>&1; then
  echo "→ Port $PORT in use, finding available port..."
  PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()' 2>/dev/null || echo 9090)
fi

# Install frontend deps if needed
if [ ! -d "$ROOT/frontend/node_modules" ]; then
  echo "→ Installing frontend dependencies..."
  (cd "$ROOT/frontend" && npm install --silent)
fi

# Build frontend → backend/static/
echo "→ Building frontend..."
(cd "$ROOT/frontend" && npm run build --silent)

# Build Go binary
echo "→ Building backend..."
(cd "$ROOT/backend" && go build -o "$ROOT/zeno" .)

# Run
echo "→ Zeno on http://localhost:$PORT"
exec "$ROOT/zeno" --port "$PORT" "${@:2}"
